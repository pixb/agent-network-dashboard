# dashboard 运行时环境变量：**变量名与占位符**。真实值不入库。
#
# 复制成 dashboard.env（同目录），填入真实值；compose.yaml 的 env_file 指向它。
# 也可用 ANET_DASHBOARD_ENV_FILE 指到仓库外的路径，这样密钥文件天然不在 git 里
# （compose.yaml 与本文件都不会进密钥值）。
#
# 硬规则：这个文件里出现任何真实 token / 密码，就是泄密。
# 提交前自检：`bash tests/compose-contract.sh` 会扫这个文件里的值形状。

# ── Hub 地址（必设，多 hub 场景）────────────────────────────────
# 变量名逐字符敏感。前端读的是 process.env.COMMHUB_URL ——
# 写成 COMM_HUB_URL 不会报错，只会静默连到代码里的默认 hub（我踩过，2026-11-04）。
# 排查症状：dashboard 显示的是「另一个 hub」的数据，改不动。
COMMHUB_URL=http://REPLACE_ME:9200

# ── dashboard 自己的登录口令（必设）────────────────────────────
# 这是你打开 dashboard 网页时输的那个口令，与 hub 的 token 是两回事。
#
# 为什么「必设」：app/lib/dashboard-auth.ts 的取值顺序是
#   DASHBOARD_PASSWORD / ANET_DASHBOARD_PASSWORD → 读不到就回落到 ~/.config/anet/cli.json 里的 hub token
# 容器里没有那个文件，回落结果是空串，于是 verifyDashboardPassword 恒为 false ——
# **谁都登不进去**，而页面照常 200、/login 照常渲染。
# 所以：容器里不设这一项 = 服务健康、探针通过、界面打不开。
# 顺带一提，回落本身也是 P0 级安全隐患（口令 == hub token，泄漏面等同），
# 代码里就带 console.warn，别看漏。
DASHBOARD_PASSWORD=REPLACE_ME

# 同一项的官方别名（app/lib/dashboard-auth.ts 先读 DASHBOARD_PASSWORD，再读这个）。
# 两个都设时以 DASHBOARD_PASSWORD 为准；只设别名也生效。
# 不要两个设成不同值：那样「登录用哪个口令」取决于读取顺序，排查时看不出来。
ANET_DASHBOARD_PASSWORD=

# ── 会话 cookie（按需）──────────────────────────────────────────
# 反代终止 TLS 时置 1，让会话 cookie 带 Secure 标记。留空 = 由代码判断。
# 症状对照：Secure cookie 发到 http:// 源上会被浏览器丢掉，表现是「登录成功但立刻又回登录页」。
COOKIE_INSECURE=

# ── Hub 认证 token（可选）──────────────────────────────────────
# 与 hub 的 MCP 认证层无关（那层用 Authorization: Bearer atok_）。
# 这里只服务 dashboard 内部的 hub 认证集成；留空 = 不启用。
COMMHUB_AUTH_TOKEN=

# ── 开发开关（生产不要设）──────────────────────────────────────
# MOCK_PROVIDERS=1 造 provider 假数据；NEXT_PUBLIC_DISABLE_SSE=1 关掉 SSE 推送。
# 生产留空。设了以后「界面显示的不是 hub 真实状态」，排查方向会整个跑偏。
MOCK_PROVIDERS=
NEXT_PUBLIC_DISABLE_SSE=

# ── compose 自身的变量（非容器内环境变量）──────────────────────
# 镜像标签与 env 文件位置。留空走 compose.yaml 里的默认值。
ANET_DASHBOARD_IMAGE_TAG=
ANET_DASHBOARD_ENV_FILE=
